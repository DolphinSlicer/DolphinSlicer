 src/libslic3r/CMakeLists.txt     |   1 +
 src/libslic3r/PortableSort.hpp   | 187 +++++++++++++++++++++++++++++++
 3 files changed, 192 insertions(+), 1 deletion(-)
 create mode 100644 src/libslic3r/PortableSort.hpp

