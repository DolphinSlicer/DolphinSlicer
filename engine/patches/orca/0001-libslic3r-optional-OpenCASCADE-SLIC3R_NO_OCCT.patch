From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DolphinSlicer <build@localhost>
Date: Sun, 8 Nov 2026 04:02:00 +0000
Subject: [PATCH 1/9] libslic3r: optional OpenCASCADE (SLIC3R_NO_OCCT)

Add a SLIC3R_NO_OCCT build option that compiles libslic3r without OpenCASCADE.
STEP.hpp keeps only its OCCT-free declarations, STEP.cpp/svg.cpp are not built,
and Model::read_from_step / SVG loading raise a RuntimeError instead.

Why: the WebAssembly engine ships STEP import as a separate, lazily loaded module
(OCCT alone would push the engine past the 25 MiB per-asset hosting limit), so the
slicing core must build without it. Default builds are unchanged.
Upstreamable: yes (opt-in, no behaviour change when the option is off).
---
 src/libslic3r/CMakeLists.txt  | 17 ++++++++++++++---
 src/libslic3r/Format/STEP.hpp | 12 +++++++++++-
 src/libslic3r/Model.cpp       | 10 ++++++++++
 3 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/src/libslic3r/CMakeLists.txt b/src/libslic3r/CMakeLists.txt
index 034f8b57..6f6db349 100644
--- a/src/libslic3r/CMakeLists.txt
+++ b/src/libslic3r/CMakeLists.txt
@@ -609,6 +609,10 @@ if (APPLE)
         )
 endif ()
 
+if (SLIC3R_NO_OCCT)
+    list(REMOVE_ITEM lisbslic3r_sources Format/STEP.cpp Format/svg.cpp Format/svg.hpp)
+endif ()
+
 add_library(libslic3r STATIC ${lisbslic3r_sources}
     "${CMAKE_CURRENT_BINARY_DIR}/libslic3r_version.h"
     ${OpenVDBUtils_SOURCES})
@@ -682,14 +686,20 @@ endif()
 target_include_directories(libslic3r PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/TextureToColor PUBLIC ${CMAKE_CURRENT_BINARY_DIR})
 target_include_directories(libslic3r SYSTEM PUBLIC ${EXPAT_INCLUDE_DIRS})
 
+find_package(JPEG REQUIRED)
+find_package(Draco REQUIRED)
+
+# SLIC3R_NO_OCCT: build without OpenCASCADE (no STEP/SVG import), e.g. for WebAssembly.
+if (SLIC3R_NO_OCCT)
+    target_compile_definitions(libslic3r PUBLIC SLIC3R_NO_OCCT)
+    set(OCCT_LIBS "")
+else ()
+
 # Find the OCCT and related libraries
 set(OpenCASCADE_DIR "${CMAKE_PREFIX_PATH}/lib/cmake/occt")
 find_package(OpenCASCADE REQUIRED)
 target_include_directories(libslic3r SYSTEM PUBLIC ${OpenCASCADE_INCLUDE_DIR})
 
-find_package(JPEG REQUIRED)
-find_package(Draco REQUIRED)
-
 set(OCCT_LIBS
     TKDESTEP
     TKDE
@@ -739,6 +749,7 @@ if (SLIC3R_CAD)
 endif ()
 # Published for the Windows packaging step in the top-level CMakeLists.txt.
 set(OCCT_LIBS "${OCCT_LIBS}" CACHE INTERNAL "OCCT toolkits linked by libslic3r")
+endif () # SLIC3R_NO_OCCT
 if (WIN32)
     # OCCT installs RelWithDebInfo and Debug builds to bin/occti and bin/occtd, so each build
     # type's DLL directory is read from the imported target, falling back to the first installed
