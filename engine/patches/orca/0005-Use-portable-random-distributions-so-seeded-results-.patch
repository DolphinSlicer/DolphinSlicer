--- /dev/null
+++ b/src/libslic3r/PortableRandom.hpp
@@ -0,0 +1,151 @@
+#pragma once
+// Platform-independent random distributions and shuffle.
+//
+// The C++ standard fixes the random engines (std::mt19937, std::mt19937_64, ...) but leaves the
+// algorithms of the distributions and of std::shuffle to the implementation. libstdc++, libc++
+// and the MSVC STL therefore turn the same seeded engine into different numbers, so code that
+// seeds an engine "for deterministic results" still produces different G-code on Linux, macOS
+// and Windows. These helpers reproduce libstdc++'s algorithms (GCC 11 to 15) exactly, so every
+// platform gets the result Linux builds already produce.
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <type_traits>
+#include <utility>
+
+namespace Slic3r {
+namespace portable_random {
+
+namespace detail {
+
+template<class URBG> constexpr uint64_t urng_range()
+{
+    return uint64_t(std::remove_reference_t<URBG>::max()) - uint64_t(std::remove_reference_t<URBG>::min());
+}
+
+template<class URBG> uint64_t draw(URBG &g) { return uint64_t(g()) - uint64_t(std::remove_reference_t<URBG>::min()); }
+
+constexpr unsigned bit_width(uint64_t v)
+{
+    unsigned n = 0;
+    for (; v; v >>= 1) ++n;
+    return n;
+}
+
+} // namespace detail
+
+// Uniform integer in [0, urange], as libstdc++'s uniform_int_distribution computes it.
+template<class URBG> uint64_t uniform_uint(URBG &g, uint64_t urange)
+{
+    constexpr uint64_t urngrange = detail::urng_range<URBG>();
+    if (urngrange > urange) {
+        const uint64_t uerange = urange + 1;
+        if constexpr (urngrange == UINT64_MAX) {
+            // Lemire's nearly divisionless method with a 128-bit product.
+            unsigned __int128 product = (unsigned __int128) uint64_t(g()) * uerange;
+            uint64_t          low     = uint64_t(product);
+            if (low < uerange) {
+                const uint64_t threshold = (0 - uerange) % uerange;
+                while (low < threshold) {
+                    product = (unsigned __int128) uint64_t(g()) * uerange;
+                    low     = uint64_t(product);
+                }
+            }
+            return uint64_t(product >> 64);
+        } else if constexpr (urngrange == UINT32_MAX) {
+            const uint32_t range   = uint32_t(uerange);
+            uint64_t       product = uint64_t(uint32_t(g())) * range;
+            uint32_t       low     = uint32_t(product);
+            if (low < range) {
+                const uint32_t threshold = (0u - range) % range;
+                while (low < threshold) {
+                    product = uint64_t(uint32_t(g())) * range;
+                    low     = uint32_t(product);
+                }
+            }
+            return product >> 32;
+        } else {
+            const uint64_t scaling = urngrange / uerange;
+            const uint64_t past    = uerange * scaling;
+            uint64_t       ret;
+            do
+                ret = detail::draw(g);
+            while (ret >= past);
+            return ret / scaling;
+        }
+    } else if (urngrange < urange) {
+        // Upscaling: combine several draws.
+        uint64_t ret, tmp;
+        do {
+            const uint64_t uerngrange = urngrange + 1;
+            tmp = uerngrange * uniform_uint(g, urange / uerngrange);
+            ret = tmp + detail::draw(g);
+        } while (ret > urange || ret < tmp);
+        return ret;
+    } else
+        return detail::draw(g);
+}
+
+// Same as std::uniform_int_distribution<IntType>(a, b)(g) with libstdc++.
+template<class IntType, class URBG> IntType uniform_int(URBG &g, IntType a, IntType b)
+{
+    static_assert(std::is_integral_v<IntType>);
+    const uint64_t urange = uint64_t(b) - uint64_t(a);
+    return IntType(uniform_uint(g, urange) + uint64_t(a));
+}
+
+// Same as std::generate_canonical<Real, std::numeric_limits<Real>::digits>(g) with libstdc++.
+template<class Real, class URBG> Real canonical(URBG &g)
+{
+    constexpr unsigned digits = std::numeric_limits<Real>::digits;
+    constexpr uint64_t range  = detail::urng_range<URBG>();
+    // log2 of (max - min + 1): the number of random bits per draw.
+    constexpr unsigned log2r  = range == UINT64_MAX ? 64 : detail::bit_width(range + 1) - 1;
+    constexpr unsigned m      = (digits + log2r - 1) / log2r > 1 ? (digits + log2r - 1) / log2r : 1;
+    const Real         r      = Real(range) + Real(1);
+    Real               sum    = Real(0);
+    Real               tmp    = Real(1);
+    for (unsigned k = m; k != 0; --k) {
+        sum += Real(detail::draw(g)) * tmp;
+        tmp *= r;
+    }
+    Real ret = sum / tmp;
+    if (ret >= Real(1))
+        ret = std::nextafter(Real(1), Real(0));
+    return ret;
+}
+
+// Same as std::uniform_real_distribution<Real>(a, b)(g) with libstdc++.
+template<class Real, class URBG> Real uniform_real(URBG &g, Real a = Real(0), Real b = Real(1))
+{
+    return canonical<Real>(g) * (b - a) + a;
+}
+
+// Same as std::shuffle(first, last, g) with libstdc++.
+template<class RandomIt, class URBG> void shuffle(RandomIt first, RandomIt last, URBG &&g)
+{
+    if (first == last)
+        return;
+    constexpr uint64_t urngrange = detail::urng_range<URBG>();
+    const uint64_t     urange    = uint64_t(last - first);
+    if (urngrange / urange >= urange) {
+        // Two swap positions per draw.
+        RandomIt i = first + 1;
+        if ((urange % 2) == 0)
+            std::iter_swap(i++, first + uniform_uint(g, 1));
+        while (i != last) {
+            const uint64_t swap_range = uint64_t(i - first) + 1;
+            const uint64_t x          = uniform_uint(g, swap_range * (swap_range + 1) - 1);
+            std::iter_swap(i++, first + x / (swap_range + 1));
+            std::iter_swap(i++, first + x % (swap_range + 1));
+        }
+        return;
+    }
+    for (RandomIt i = first + 1; i != last; ++i)
+        std::iter_swap(i, first + uniform_uint(g, uint64_t(i - first)));
+}
+
+} // namespace portable_random
+} // namespace Slic3r
